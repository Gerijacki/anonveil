# Shared look-and-feel for every AnonVeil capture — sourced by the other
# .tape files in this directory so they can't drift from each other.
# Colors approximate crates/anonveil-cli/src/{style.rs,tui/theme.rs}'s
# real palette (neon green on near-black) rather than a generic terminal
# theme, so these captures actually look like AnonVeil.
Set FontFamily "DejaVu Sans Mono"
Set FontSize 18
Set Width 1360
Set Height 800
Set Padding 20
Set Theme {"name":"anonveil","black":"#0a0a0c","red":"#ff5a5a","green":"#00ff9c","yellow":"#ffd154","blue":"#4fa8ff","purple":"#c77dff","cyan":"#33ccff","white":"#d6ffe0","brightBlack":"#78827f","brightRed":"#ff5a5a","brightGreen":"#00ff9c","brightYellow":"#ffd154","brightBlue":"#4fa8ff","brightPurple":"#c77dff","brightCyan":"#33ccff","brightWhite":"#ffffff","background":"#0a0a0c","foreground":"#d6ffe0","cursor":"#00ff9c","selection":"#0c8c5a"}
Set Shell bash
